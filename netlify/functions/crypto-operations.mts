import type { Config } from "@netlify/functions"
import { approvedKyc, customer, idempotency, money, response } from "./_shared/finance.mts"

async function btcPrice(){const r=await fetch("https://api.coinbase.com/v2/prices/BTC-USD/spot",{headers:{Accept:"application/json"},signal:AbortSignal.timeout(5000)});if(!r.ok)throw Object.assign(new Error("BTC market price is currently unavailable."),{status:503});const j=await r.json() as {data?:{amount?:string}};if(!j.data?.amount||Number(j.data.amount)<=0)throw Object.assign(new Error("BTC market price is currently unavailable."),{status:503});return j.data.amount}
export default async(req:Request)=>{try{const {customer:c,db}=await customer();if(req.method==="GET"){const [asset,deposits,withdrawals,price]=await Promise.all([db.pool.query(`SELECT cb.available::text,cb.reserved::text FROM crypto_balances cb JOIN crypto_assets a ON a.id=cb.asset_id WHERE cb.user_id=$1 AND a.symbol='BTC'`,[c.id]),db.pool.query(`SELECT deposit_id,amount::text,status,transaction_hash,created_at FROM crypto_deposits WHERE customer_id=$1 AND asset='BTC' ORDER BY created_at DESC LIMIT 50`,[c.id]),db.pool.query(`SELECT withdrawal_id,requested_amount::text,status,destination_address,created_at FROM crypto_withdrawals w JOIN crypto_assets a ON a.id=w.asset_id WHERE w.user_id=$1 AND a.symbol='BTC' ORDER BY w.created_at DESC LIMIT 50`,[c.id]),btcPrice().catch(()=>null)]);return Response.json({depositAddress:Netlify.env.get("BTC_DEPOSIT_ADDRESS")??null,balance:asset.rows[0]??{available:"0",reserved:"0"},deposits:deposits.rows,withdrawals:withdrawals.rows,marketPriceUsd:price,priceSource:price?"Coinbase spot":null})}if(req.method!=="POST")return new Response("Method not allowed",{status:405});const b=await req.json() as Record<string,unknown>,action=String(b.action),key=idempotency(req,b);await approvedKyc(db.pool,c.id);if(action==="deposit"){const address=Netlify.env.get("BTC_DEPOSIT_ADDRESS");if(!address)throw Object.assign(new Error("BTC deposits are not configured."),{status:503});const amount=money(b.amount),hash=String(b.transactionHash??"").trim();if(!/^[A-Fa-f0-9]{64}$/.test(hash))throw Object.assign(new Error("A valid Bitcoin transaction hash is required."),{status:400});const old=await db.pool.query(`SELECT deposit_id,status FROM crypto_deposits WHERE idempotency_key=$1`,[key]);if(old.rows[0])return Response.json(old.rows[0]);const price=await btcPrice(),id=`DEP-${crypto.randomUUID()}`;const result=await db.pool.query(`INSERT INTO crypto_deposits(deposit_id,customer_id,asset,network,receiving_address,amount,transaction_hash,status,idempotency_key,market_price,valuation_currency,valuation_amount,price_timestamp,price_source) VALUES($1,$2,'BTC','Bitcoin',$3,$4,$5,'PENDING',$6,$7,'USD',$4::numeric*$7::numeric,now(),'Coinbase spot') RETURNING deposit_id,status`,[id,c.id,address,amount,hash,key,price]);return Response.json(result.rows[0],{status:201})}if(action==="withdrawal"){const amount=money(b.amount),destination=String(b.destinationAddress??"").trim();if(destination.length<26||destination.length>90)throw Object.assign(new Error("A valid Bitcoin destination address is required."),{status:400});const old=await db.pool.query(`SELECT withdrawal_id,status FROM crypto_withdrawals WHERE idempotency_key=$1`,[key]);if(old.rows[0])return Response.json(old.rows[0]);const price=await btcPrice(),id=`WDR-${crypto.randomUUID()}`,activity=`ACT-${crypto.randomUUID()}`;const result=await db.pool.query(`INSERT INTO crypto_withdrawals(withdrawal_id,activity_id,user_id,asset_id,destination_address,requested_amount,estimated_network_fee,price,estimated_usd,status,idempotency_key,security_verified_at,network,customer_note) SELECT $1,$2,$3,id,$4,$5,0,$6,$5::numeric*$6::numeric,'PENDING_REVIEW',$7,now(),'Bitcoin',$8 FROM crypto_assets WHERE symbol='BTC' RETURNING withdrawal_id,status`,[id,activity,c.id,destination,amount,price,key,String(b.note??"").slice(0,240)]);return Response.json(result.rows[0],{status:201})}throw Object.assign(new Error("Unsupported crypto operation."),{status:400})}catch(e){return response(e)}}
export const config:Config={path:"/api/crypto"}

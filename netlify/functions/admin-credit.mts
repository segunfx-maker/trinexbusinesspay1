import type { Config } from "@netlify/functions"
import { accountNumber, financeAdmin, idempotency, money, response } from "./_shared/finance.mts"
export default async(req:Request)=>{try{if(req.method!=="POST")return new Response("Method not allowed",{status:405});const {admin,db}=await financeAdmin();const b=await req.json() as Record<string,unknown>;const num=accountNumber(b.accountNumber),amount=money(b.amount),currency=String(b.currency??"").toUpperCase(),reason=String(b.reason??"").trim(),key=idempotency(req,b);if(currency!=="USD"||reason.length<8)throw Object.assign(new Error("USD and a detailed reason are required."),{status:400});const c=await db.pool.connect();try{await c.query("BEGIN");const old=await c.query(`SELECT id FROM admin_account_credits WHERE idempotency_key=$1 OR (account_id=(SELECT id FROM accounts WHERE internal_account_number=$2) AND amount=$3 AND currency=$4 AND reason=$5)`,[key,num,amount,currency,reason]);if(old.rows[0]){await c.query("COMMIT");return Response.json({status:"COMPLETED",duplicate:true})}const a=await c.query(`SELECT a.id,a.currency,a.status,la.id ledger_id FROM accounts a JOIN ledger_accounts la ON la.account_id=a.id WHERE a.internal_account_number=$1 AND a.account_owner_type='CUSTOMER' FOR UPDATE`,[num]);if(!a.rows[0]||a.rows[0].status!=="ACTIVE"||a.rows[0].currency!==currency)throw Object.assign(new Error("Matching active account not found."),{status:404});const sys=await c.query(`SELECT la.id FROM accounts a JOIN ledger_accounts la ON la.account_id=a.id WHERE a.account_owner_type='SYSTEM' AND a.currency=$1 AND a.environment='PRODUCTION' LIMIT 1`,[currency]);if(!sys.rows[0])throw Object.assign(new Error("System settlement account is not configured."),{status:503});const activity=`ACT-${crypto.randomUUID()}`,ref=`CRD-${crypto.randomUUID()}`;const tx=await c.query(`INSERT INTO transactions(transaction_id,activity_id,idempotency_key,currency,amount,status,environment,event_type) VALUES($1,$2,$3,$4,$5,'COMPLETED','PRODUCTION','ADMIN_CREDIT') RETURNING id`,[ref,activity,`tx:${key}`,currency,amount]);const audit=await c.query(`INSERT INTO audit_events(activity_id,actor_identity_id,action,entity_type,entity_id,metadata) VALUES($1,$2,'ADMIN_ACCOUNT_CREDIT','account',$3,$4) RETURNING id`,[activity,admin.identity_id,a.rows[0].id,JSON.stringify({reason,currency,amount})]);await c.query(`INSERT INTO ledger_entries(transaction_id,ledger_account_id,direction,amount,currency) VALUES($1,$2,'DEBIT',$4,$3),($1,$5,'CREDIT',$4,$3)`,[tx.rows[0].id,sys.rows[0].id,currency,amount,a.rows[0].ledger_id]);await c.query(`INSERT INTO admin_account_credits(transaction_id,account_id,amount,currency,admin_identity_id,reason,audit_event_id,idempotency_key) VALUES($1,$2,$3,$4,$5,$6,$7,$8)`,[tx.rows[0].id,a.rows[0].id,amount,currency,admin.identity_id,reason,audit.rows[0].id,key]);await c.query("COMMIT");return Response.json({status:"COMPLETED",transactionReference:ref},{status:201})}catch(e){await c.query("ROLLBACK");throw e}finally{c.release()}}catch(e){return response(e)}}
export const config:Config={path:"/api/admin/credits"}

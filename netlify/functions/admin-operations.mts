import type { Config } from "@netlify/functions"
import { financeAdmin, response } from "./_shared/finance.mts"
export default async(req:Request)=>{try{const {admin,db}=await financeAdmin();if(req.method==="GET"){const section=new URL(req.url).searchParams.get("section")??"summary";const queries:Record<string,string>={customers:`SELECT id,email,full_name,trinex_id,created_at FROM users ORDER BY created_at DESC LIMIT 100`,accounts:`SELECT a.internal_account_number,a.currency,a.status,u.full_name FROM accounts a LEFT JOIN users u ON u.id=a.user_id WHERE a.account_owner_type='CUSTOMER' ORDER BY a.created_at DESC LIMIT 200`,transactions:`SELECT transaction_id,event_type,currency,amount::text,status,created_at FROM transactions ORDER BY created_at DESC LIMIT 200`,transfers:`SELECT transfer_reference,currency,amount::text,status,created_at FROM transfers ORDER BY created_at DESC LIMIT 200`,deposits:`SELECT deposit_id,asset,amount::text,status,created_at FROM crypto_deposits ORDER BY created_at DESC LIMIT 200`,withdrawals:`SELECT withdrawal_id,requested_amount::text,status,created_at FROM crypto_withdrawals ORDER BY created_at DESC LIMIT 200`,investments:`SELECT investment_id,plan_id,funding_asset,principal_amount::text,status,created_at FROM investment_positions ORDER BY created_at DESC LIMIT 200`,audit:`SELECT activity_id,actor_identity_id,action,entity_type,entity_id,created_at FROM audit_events ORDER BY created_at DESC LIMIT 200`,reconciliation:`SELECT t.transaction_id,t.currency,t.amount::text,COALESCE(sum(CASE WHEN e.direction='DEBIT' THEN e.amount ELSE -e.amount END),0)::text imbalance FROM transactions t LEFT JOIN ledger_entries e ON e.transaction_id=t.id GROUP BY t.id HAVING COALESCE(sum(CASE WHEN e.direction='DEBIT' THEN e.amount ELSE -e.amount END),0)<>0 ORDER BY t.created_at DESC`};if(section==="summary"){const r=await db.pool.query(`SELECT (SELECT count(*) FROM users) customers,(SELECT count(*) FROM accounts WHERE account_owner_type='CUSTOMER') accounts,(SELECT count(*) FROM transactions) transactions,(SELECT count(*) FROM transfers) transfers,(SELECT count(*) FROM crypto_deposits WHERE status IN ('PENDING','UNDER_REVIEW')) pending_deposits,(SELECT count(*) FROM crypto_withdrawals WHERE status='PENDING_REVIEW') pending_withdrawals,(SELECT count(*) FROM investment_positions WHERE status='ACTIVE') active_investments`);return Response.json(r.rows[0])}if(!queries[section])throw Object.assign(new Error("Unknown operations section."),{status:400});return Response.json({items:(await db.pool.query(queries[section])).rows})}if(req.method!=="POST")return new Response("Method not allowed",{status:405});const b=await req.json() as Record<string,unknown>,kind=String(b.kind),id=String(b.id),decision=String(b.decision).toUpperCase(),reason=String(b.reason??"").trim();if(!["APPROVED","REJECTED"].includes(decision)||reason.length<8)throw Object.assign(new Error("A decision and detailed reason are required."),{status:400});const table=kind==="crypto_deposit"?"crypto_deposits":kind==="crypto_withdrawal"?"crypto_withdrawals":null;if(!table)throw Object.assign(new Error("Unsupported review type."),{status:400});const idColumn=kind==="crypto_deposit"?"deposit_id":"withdrawal_id",client=await db.pool.connect();try{await client.query("BEGIN");const current=await client.query(`SELECT status FROM ${table} WHERE ${idColumn}=$1 FOR UPDATE`,[id]);if(!current.rows[0])throw Object.assign(new Error("Operation not found."),{status:404});if(!["PENDING","UNDER_REVIEW","PENDING_REVIEW"].includes(current.rows[0].status))throw Object.assign(new Error("Operation has already been reviewed."),{status:409});if(kind==="crypto_deposit")await client.query(`UPDATE crypto_deposits SET status=$2,reviewing_admin_identity_id=$3,review_note=$4,reviewed_at=now(),updated_at=now() WHERE deposit_id=$1`,[id,decision,admin.identity_id,reason]);else await client.query(`UPDATE crypto_withdrawals SET status=$2,reviewing_admin_identity_id=$3,admin_note=$4,reviewed_at=now(),updated_at=now() WHERE withdrawal_id=$1`,[id,decision,admin.identity_id,reason]);await client.query(`INSERT INTO audit_events(activity_id,actor_identity_id,action,entity_type,entity_id,metadata) VALUES($1,$2,$3,$4,$5,$6)`,[`ACT-${crypto.randomUUID()}`,admin.identity_id,`${kind.toUpperCase()}_${decision}`,kind,id,JSON.stringify({reason})]);await client.query("COMMIT");return Response.json({id,status:decision})}catch(e){await client.query("ROLLBACK");throw e}finally{client.release()}}catch(e){return response(e)}}
export const config:Config={path:"/api/admin/operations"}

import type { Config } from "@netlify/functions"
import { approvedKyc, customer, idempotency, investmentAmount, response } from "./_shared/finance.mts"
export default async(req:Request)=>{try{const {customer:c,db}=await customer();if(req.method==="GET"){const r=await db.pool.query(`SELECT investment_id,plan_id,plan_name,funding_asset,principal_amount::text,principal_usd::text,current_performance::text,current_value::text,status,start_date,next_performance_date FROM investment_positions WHERE customer_id=$1 ORDER BY created_at DESC`,[c.id]);return Response.json({positions:r.rows,performanceDisclaimer:"Configured performance is an application projection, not a guaranteed external investment return."})}if(req.method!=="POST")return new Response("Method not allowed",{status:405});const b=await req.json() as Record<string,unknown>,plan=String(b.plan??"").toUpperCase(),amount=investmentAmount(plan,b.amount),key=idempotency(req,b),currency=String(b.currency??"").toUpperCase();if(currency!=="USD")throw Object.assign(new Error("Only USD funding is enabled until a verified valuation source is configured for other assets."),{status:400});const client=await db.pool.connect();try{await client.query("BEGIN");await approvedKyc(client,c.id);const old=await client.query(`SELECT investment_id,status FROM investment_positions WHERE idempotency_key=$1`,[key]);if(old.rows[0]){await client.query("COMMIT");return Response.json(old.rows[0])}const a=await client.query(`SELECT a.id,la.id ledger_id,COALESCE((SELECT sum(CASE WHEN direction='CREDIT' THEN amount ELSE -amount END) FROM ledger_entries WHERE account_id=a.id AND status='COMPLETED'),0) balance FROM accounts a JOIN ledger_accounts la ON la.account_id=a.id WHERE a.user_id=$1 AND a.currency='USD' AND a.status='ACTIVE' FOR UPDATE OF a`,[c.id]);if(!a.rows[0]||Number(a.rows[0].balance)<Number(amount))throw Object.assign(new Error("Insufficient available balance."),{status:409});const sys=await client.query(`SELECT la.id FROM accounts a JOIN ledger_accounts la ON la.account_id=a.id WHERE a.account_owner_type='SYSTEM' AND a.currency='USD' AND a.environment='PRODUCTION' LIMIT 1`);if(!sys.rows[0])throw Object.assign(new Error("Investment settlement account is not configured."),{status:503});const p=await client.query(`SELECT name,configured_monthly_rate FROM investment_plans WHERE id=$1 AND status='ACTIVE'`,[plan]);if(!p.rows[0])throw Object.assign(new Error("Investment plan is unavailable."),{status:404});const activity=`ACT-${crypto.randomUUID()}`,ref=`INV-${crypto.randomUUID()}`;const tx=await client.query(`INSERT INTO transactions(transaction_id,activity_id,idempotency_key,currency,amount,status,environment,event_type) VALUES($1,$2,$3,'USD',$4,'COMPLETED','PRODUCTION','INVESTMENT_FUNDING') RETURNING id`,[ref,activity,`tx:${key}`,amount]);await client.query(`INSERT INTO audit_events(activity_id,actor_identity_id,action,entity_type,entity_id,metadata) VALUES($1,$2,'INVESTMENT_FUNDING','investment',$3,$4)`,[activity,c.id,ref,JSON.stringify({plan,amount})]);await client.query(`INSERT INTO ledger_entries(transaction_id,ledger_account_id,direction,amount,currency) VALUES($1,$2,'DEBIT',$3,'USD'),($1,$4,'CREDIT',$3,'USD')`,[tx.rows[0].id,a.rows[0].ledger_id,amount,sys.rows[0].id]);const pos=await client.query(`INSERT INTO investment_positions(investment_id,customer_id,plan_id,plan_name,funding_asset,funding_asset_type,funding_account_id,principal_amount,principal_usd,configured_monthly_rate,current_value,status,start_date,next_performance_date,funding_ledger_transaction_id,activity_id,idempotency_key) VALUES($1,$2,$3,$4,'USD','FIAT',$5,$6,$6,$7,$6,'ACTIVE',now(),now()+interval '1 month',$8,$9,$10) RETURNING investment_id,status`,[ref,c.id,plan,p.rows[0].name,a.rows[0].id,amount,p.rows[0].configured_monthly_rate,tx.rows[0].id,activity,key]);await client.query(`INSERT INTO investment_engine_transactions(transaction_id,investment_id,customer_id,type,asset,amount,status,description,ledger_transaction_id,activity_id) SELECT $1,id,$2,'INVESTMENT_FUNDING','USD',$3,'COMPLETED','Ledger-funded investment',$4,$5 FROM investment_positions WHERE investment_id=$1`,[ref,c.id,amount,tx.rows[0].id,activity]);await client.query("COMMIT");return Response.json(pos.rows[0],{status:201})}catch(e){await client.query("ROLLBACK");throw e}finally{client.release()}}catch(e){return response(e)}}
export const config:Config={path:"/api/investments"}
